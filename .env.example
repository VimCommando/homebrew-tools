# SSH host alias or user@host for the Linux x86_64 builder.
LINUX_SSH_HOST=linux-builder

# URL Homebrew should put in generated bottle blocks.
BOTTLE_ROOT_URL=https://github.com/VimCommando/homebrew-tools/releases/download/bottles

# Tap name used for Homebrew-qualified formula names.
HOMEBREW_TAP=VimCommando/tools

# Container image used on the remote Linux host.
LINUX_PODMAN_IMAGE=docker.io/homebrew/brew:latest

# Optional space-separated formula list. Defaults to "espipe jsrmx kibob".
BOTTLE_FORMULAE="espipe jsrmx kibob"
